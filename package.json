{
  "name": "coolify-deploy-mailer",
  "version": "1.0.0",
  "private": true,
  "description": "Emails your team which commit Coolify deployed. Receives Coolify webhooks, verifies them with the Coolify API, and sends React Email notifications.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsdown",
    "start": "node --enable-source-maps dist/index.mjs",
    "typecheck": "tsc",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check .",
    "fix": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "verify": "npm run typecheck && npm run check && npm run test:coverage",
    "docker:build": "docker build -t coolify-deploy-mailer .",
    "secret": "node -e \"console.log(require('node:crypto').randomBytes(32).toString('hex'))\"",
    "prepare": "husky",
    "email:dev": "email dev --dir src/emails/previews --port 3030",
    "email:export": "email export --dir src/emails/previews --outDir out/emails",
    "unused": "knip"
  },
  "lint-staged": {
    "*.{ts,tsx,js,json,jsonc}": "biome check --write --no-errors-on-unmatched --files-ignore-unknown=true",
    "*.{ts,tsx}": "bash -c 'tsc --noEmit'"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ],
    "rules": {
      "scope-enum": [
        2,
        "always",
        [
          "api",
          "config",
          "deps",
          "docker",
          "docs",
          "emails",
          "http",
          "notifier",
          "schemas",
          "services",
          "tests",
          "tooling",
          "types",
          "utils"
        ]
      ],
      "subject-case": [
        2,
        "never",
        [
          "start-case",
          "pascal-case",
          "upper-case"
        ]
      ],
      "body-max-line-length": [
        2,
        "always",
        100
      ]
    }
  },
  "dependencies": {
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "lru-cache": "^11.5.3",
    "nodemailer": "^10.0.10",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-email": "6.11.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@react-email/ui": "6.11.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.3",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/smtp-server": "^3.5.13",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.0.2",
    "husky": "^9.1.7",
    "knip": "^6.38.0",
    "lint-staged": "^17.6.0",
    "pino-pretty": "^13.1.3",
    "smtp-server": "^3.19.13",
    "supertest": "^7.3.0",
    "tsdown": "^0.23.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.2"
  },
  "keywords": [
    "coolify",
    "webhook",
    "deployment",
    "email",
    "notifications",
    "react-email",
    "express",
    "typescript"
  ],
  "author": "dharmveer97"
}
