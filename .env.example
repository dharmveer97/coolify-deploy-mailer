# ─── Server ───────────────────────────────────────────────────────────────
# development | production | test
NODE_ENV=production
PORT=3000
# fatal | error | warn | info | debug | trace
LOG_LEVEL=info
# Set to true only when running behind a reverse proxy (Coolify/Traefik/Caddy)
TRUST_PROXY=false

# ─── Webhook security ─────────────────────────────────────────────────────
# Long random secret, 32+ chars of letters, digits, - or _. Generate one with:
#   openssl rand -hex 32
# Coolify webhook URL becomes: https://<this-server>/webhooks/coolify/<WEBHOOK_SECRET>
WEBHOOK_SECRET=
WEBHOOK_RATE_LIMIT_PER_MINUTE=60
# Optional but recommended: only these IPs / CIDR ranges may call the webhook (comma-separated).
# Use your Coolify server's IP. Behind a reverse proxy, also set TRUST_PROXY=true.
WEBHOOK_ALLOWED_IPS=

# ─── Coolify API (used to look up commit details) ─────────────────────────
# URL this service uses to call the Coolify API, without /api. Use https:// unless it is an
# internal Docker hostname on the same private network (e.g. http://coolify:8080).
COOLIFY_URL=https://coolify.example.com
# URL your team opens in the browser; used for the "View deployment logs" link.
# Defaults to COOLIFY_URL.
COOLIFY_PUBLIC_URL=
# Keys & Tokens → API tokens. "read" permission is enough.
COOLIFY_API_TOKEN=
COOLIFY_API_TIMEOUT_MS=10000
# Used for repositories stored as "owner/repo" (GitHub App sources). Change for GitHub Enterprise.
GIT_BASE_URL=https://github.com

# ─── SMTP ─────────────────────────────────────────────────────────────────
SMTP_HOST=smtp.example.com
# 587 = STARTTLS (SMTP_SECURE=false), 465 = TLS (SMTP_SECURE=true)
SMTP_PORT=587
SMTP_SECURE=false
# Require STARTTLS before logging in, so the password is never sent in plain text.
# Only set to false for a local test server like Mailpit (which needs no password).
SMTP_REQUIRE_TLS=true
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM="Coolify Deployments <deployments@example.com>"
# Comma-separated list of recipients
MAIL_TO=dev-team@example.com

# ─── What to send ─────────────────────────────────────────────────────────
NOTIFY_ON_SUCCESS=true
NOTIFY_ON_FAILURE=true
